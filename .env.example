# 복사해서 `.env` 로 저장한 뒤 `npx expo start` (또는 아래 npm 스크립트)
# 로그인 없이 변환 플로우만 빠르게 테스트할 때
EXPO_PUBLIC_SKIP_AUTH=1

# 프리미엄 테마·한도 없이 전부 테스트
EXPO_PUBLIC_PREMIUM_TEST=1

# 나머지는 기존처럼
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_BACKEND_URL=

# App Store / Google Play (RevenueCat) — 모바일 인앱 결제
# RevenueCat 대시보드 → API keys → Public (iOS / Android 각각 권장)
EXPO_PUBLIC_REVENUECAT_API_KEY=
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# 백엔드(backend/.env.local): REVENUECAT_WEBHOOK_AUTHORIZATION (웹훅 Bearer와 동일한 값)
# Stripe는 스토어 앱에서 사용하지 않음 (레거시/웹 전용으로만 유지 가능)
