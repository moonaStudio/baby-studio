# 복사해서 `.env` 로 저장한 뒤 `npx expo start` (또는 아래 npm 스크립트)
# 로그인 없이 변환 플로우만 빠르게 테스트할 때
EXPO_PUBLIC_SKIP_AUTH=1

# 프리미엄 테마·한도 없이 전부 테스트
EXPO_PUBLIC_PREMIUM_TEST=1

# 나머지는 기존처럼
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_BACKEND_URL=

# Stripe는 Next 백엔드(backend/.env.local)에만 두면 됩니다.
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SITE_URL, SUPABASE_SERVICE_ROLE_KEY
# Supabase에는 supabase/migrations/20260502000000_billing_stripe.sql 적용 필요
