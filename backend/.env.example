# OpenAI / Replicate 등 기존 키는 그대로 두세요.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 공개 HTTPS 베이스 (Stripe success/cancel URL에 사용, 끝 슬래시 없이)
SITE_URL=https://your-backend.example.com

# 앱 딥링크 스킴 (app.json scheme과 동일 권장)
NEXT_PUBLIC_APP_SCHEME=babystudio

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 웹 어드민 (/admin/themes) — 긴 랜덤 문자열 권장
ADMIN_SECRET=
